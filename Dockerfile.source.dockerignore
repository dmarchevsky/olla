# Docker/BuildKit honours a per-Dockerfile ignore file named
# <dockerfile-filename>.dockerignore, taking precedence over the root
# .dockerignore for `docker build -f Dockerfile.source`. The root
# .dockerignore is an allowlist for the prebuilt-artifact Dockerfile - wrong
# here, since Dockerfile.source needs the full source tree (internal/,
# main.go, go.mod/go.sum, web/dashboard/src, config/, scripts/, .git for
# version metadata). This file is a denylist of build noise instead.

# VCS metadata other than .git itself (needed by `git describe`/`git rev-parse`
# for version injection - see Dockerfile.source's builder stage).
.git/hooks
.github

# Frontend build artefacts - rebuilt fresh in the frontend stage.
web/dashboard/node_modules
web/dashboard/coverage
web/dashboard/.svelte-kit

# go:embed dist is gitignored and rebuilt by the frontend stage; only the
# committed .gitkeep sentinel is meaningful to keep, and even that is
# regenerated by `bun run build` before the builder stage overlays it.
internal/app/handlers/dashboard/dist

# Host-side build outputs, not needed inside the image build.
bin/
build/
dist/
*.log

# Editor / agent scratch, not part of the source tree.
.vscode
.claude
.idea
